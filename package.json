{
  "name": "solhealth",
  "type": "module",
  "license": "ISC",
  "scripts": {
    "lint:fix": "prettier */*.js \"*/**/*{.js,.ts}\" -w",
    "lint": "prettier */*.js \"*/**/*{.js,.ts}\" --check",
    "build": "npm --prefix app run build",
    "bench": "BENCH_OUT=bench-results/local npx tsx scripts/bench.ts",
    "bench:devnet": "BENCH_RPC=https://api.devnet.solana.com BENCH_OUT=bench-results/devnet npx tsx scripts/bench.ts",
    "demo:reset": "bash scripts/reset-local.sh"
  },
  "dependencies": {
    "@anchor-lang/core": "^1.0.0",
    "@coral-xyz/anchor": "^0.32.1",
    "ed2curve": "^0.3.0",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@types/bn.js": "^5.1.0",
    "@types/chai": "^4.3.0",
    "@types/ed2curve": "^0.2.4",
    "@types/mocha": "^9.0.0",
    "chai": "^4.3.4",
    "mocha": "^9.0.3",
    "prettier": "^2.6.2",
    "ts-mocha": "^10.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3"
  }
}
