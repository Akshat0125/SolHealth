# SolHealth Environment Configuration - Solana Devnet (Production / Staging)
# Use these variable names when deploying to Vercel

# Solana Network Cluster ("local" or "devnet")
NEXT_PUBLIC_CLUSTER=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# Demo Mode: Disable simulated in-browser identities in production so users connect real wallets
NEXT_PUBLIC_ENABLE_DEMO=false

# IPFS Pinning Service (Server-side only, scoped to file write/pinning only)
PINATA_JWT=PASTE_YOUR_PINATA_JWT_HERE

# Uploads Kill-Switch: Set to "true" to enable uploads ("false" disables uploads with HTTP 503)
UPLOADS_ENABLED=true
