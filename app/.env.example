# SolHealth Environment Configuration - Solana Devnet (Production / Staging)
# Copy this file to app/.env.local for local overrides.

# Solana Network Cluster ("devnet" or "local")
NEXT_PUBLIC_CLUSTER=devnet

# Solana RPC Endpoint URL (Defaults to public Devnet RPC; use private Alchemy/Helius for production)
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# SolHealth Anchor Program ID on Solana Devnet
NEXT_PUBLIC_PROGRAM_ID=52sv1bDkPFyi8mwVG2eYLYPXPmr6n1oTBmmDLsjC9Hhq

# Demo Mode: Enable/disable in-browser simulated test keypairs
NEXT_PUBLIC_ENABLE_DEMO=true

# IPFS Pinning Service (Pinata JWT, server-side only in API route; never exposed to browser)
PINATA_JWT=your_pinata_jwt_here

# Uploads Kill-Switch: Set to "true" to enable uploads ("false" disables pinning with 503)
UPLOADS_ENABLED=true

# Orbit Assistant Kill-Switch: Set to "false" to disable the Orbit assistant (default: true)
NEXT_PUBLIC_ENABLE_GUIDE=true
