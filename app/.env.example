# SolHealth Environment Configuration - Local Validator
# Copy to app/.env.local for local development

# Solana Network Cluster ("local" or "devnet")
NEXT_PUBLIC_CLUSTER=local
NEXT_PUBLIC_SOLANA_RPC_URL=http://127.0.0.1:8899

# Demo Mode: Enable simulated in-browser identities for testing without browser extension wallets
NEXT_PUBLIC_ENABLE_DEMO=true

# IPFS Pinning Service (Server-side only, never exposed to client)
PINATA_JWT=PASTE_YOUR_PINATA_JWT_HERE

# Uploads Kill-Switch: Set to "false" to disable file pinning in API route
UPLOADS_ENABLED=true

# Guide Bot Kill-Switch: Set to "false" to disable the Guide Bot (default: true)
NEXT_PUBLIC_ENABLE_GUIDE=true
