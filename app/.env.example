# SolHealth Environment Configuration Example
# Copy this file to app/.env.local and populate the values.

# IPFS Pinning Service (Pinata JWT token)
PINATA_JWT=your_pinata_jwt_token_here

# Optional: Solana Network Cluster Selection ("local" or "devnet")
# Defaults to "local" (http://127.0.0.1:8899) if omitted
NEXT_PUBLIC_CLUSTER=local
NEXT_PUBLIC_SOLANA_RPC_URL=http://127.0.0.1:8899

# To connect directly to Devnet:
# NEXT_PUBLIC_CLUSTER=devnet
# NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
